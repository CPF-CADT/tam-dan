<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20261021000400" author="tamdan">
        <createTable tableName="pairing_code">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="family_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="child_profile_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="code_hash" type="varchar(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_pairing_code_hash"/>
            </column>
            <column name="expires_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="timestamp"/>
            <column name="failed_attempts" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_parent_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="pairing_code" baseColumnNames="family_id"
                                 referencedTableName="family" referencedColumnNames="id"
                                 constraintName="fk_pairing_code_family"/>
        <addForeignKeyConstraint baseTableName="pairing_code" baseColumnNames="child_profile_id"
                                 referencedTableName="child_profile" referencedColumnNames="id"
                                 constraintName="fk_pairing_code_child"/>
        <addForeignKeyConstraint baseTableName="pairing_code" baseColumnNames="created_by_parent_id"
                                 referencedTableName="jhi_user" referencedColumnNames="id"
                                 constraintName="fk_pairing_code_parent"/>
    </changeSet>
</databaseChangeLog>
